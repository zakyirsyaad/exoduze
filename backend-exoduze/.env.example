PORT=3000
HOST=0.0.0.0
# Supabase direct database URLs are IPv6-only unless you enable the IPv4 add-on.
# For local IPv4-only networks, use the Supabase Session pooler URL from Dashboard > Connect.
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_SSL=require
ADMIN_SOLANA_WALLET=HynCU9tq6jug7p7ASimcT2rJK8nvVbmwcSvGX6E2rMBS
SOLANA_RPC_URL=https://api.devnet.solana.com
EXODUZE_PROGRAM_ID=C8ih3DKPzNi84Vg9BYx3iRcPWaZLS1iFJ9RVu5dzdswi
# Must be the on-chain config admin keypair. On devnet this is the deploy wallet, not the oracle/treasury wallet.
EXODUZE_ADMIN_KEYPAIR_PATH=/home/kayz/.config/solana/id.json
# Optional dedicated oracle keypair for on-chain resolve_market. Falls back to EXODUZE_ADMIN_KEYPAIR_PATH when omitted.
EXODUZE_ORACLE_KEYPAIR_PATH=/home/kayz/.config/solana/oracle.json
# Devnet settlement mint used by create_market.
EXODUZE_SETTLEMENT_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
EXODUZE_TOKEN_PROGRAM_ID=TokenkegQfeZyiNwAJbNbGKPFXCWuBvf9Ss623VQ5DA
AUTH_CHALLENGE_TTL_MINUTES=5
AUTH_SESSION_TTL_HOURS=168
NEWSAPI_API_KEY=
NEWSAPI_BASE_URL=https://newsapi.org/v2
NEWSAPI_LANGUAGE=en
NEWSAPI_COUNTRY=us
FINNHUB_API_KEY=
FINNHUB_BASE_URL=https://finnhub.io/api/v1
FINNHUB_FINANCE_SYMBOLS=TSLA
FINNHUB_COMPANY_NEWS_LOOKBACK_DAYS=30
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_AGENT_AVATARS_BUCKET=agent-avatars
AI_DECISION_PROVIDER=heuristic
AI_CANONICALIZATION_VERSION=exoduze-ai-v1
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-5.4-mini
OPENAI_DECISION_MAX_OUTPUT_TOKENS=900
FEED_REFRESH_TTL_MINUTES=20
MARKET_DEFAULT_JOIN_WINDOW_RATIO=0.25
MARKET_DEFAULT_MIN_JOIN_WINDOW_HOURS=6
MARKET_DEFAULT_MAX_JOIN_WINDOW_HOURS=24
MARKET_HIDE_LIVE_AGENT_DECISIONS_UNTIL_JOIN_DEADLINE=true
AUTONOMOUS_MARKET_ENABLED=false
AUTONOMOUS_MARKET_INTERVAL_SECONDS=300
# Leave blank to use every active category that has hot_topic_snapshots data.
AUTONOMOUS_MARKET_CATEGORIES=finance,crypto,politics,science,sports
AUTONOMOUS_SNAPSHOT_TOPIC_LIMIT=10
AUTONOMOUS_MARKET_REQUIRED_RANK=3
AUTONOMOUS_MARKET_MAX_MARKETS_PER_CATEGORY=3
AUTONOMOUS_MARKET_MIN_TOPIC_CONFIDENCE=0.35
AUTONOMOUS_AUTO_PUBLISH_ONCHAIN=true
AUTONOMOUS_PUBLISH_BATCH_SIZE=25
AUTONOMOUS_RESOLVE_ONCHAIN=true
# Set to 0 for a fully autonomous resolver flow with no human dispute window.
AUTONOMOUS_RESOLUTION_DISPUTE_WINDOW_MINUTES=0
MARKET_DISPUTE_WINDOW_MINUTES=60
MARKET_GENERATION_ENABLED=true
ORACLE_RESOLUTION_ENABLED=true
# Fee taken from generated claimable payouts, in basis points. 0 means no fee.
PAYOUT_FEE_BPS=0
COINGECKO_BASE_URL=https://api.coingecko.com/api/v3
